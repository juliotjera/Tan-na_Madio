{
  "name": "tanana-madio-api",
  "version": "1.0.0",
  "description": "API Tanàna Madio : signalement et collecte optimisée des déchets à Antananarivo",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "cross-env NODE_ENV=test DB_MODE=memoire NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "db:sync": "node scripts/syncDb.js",
    "db:seed": "node scripts/seedDb.js",
    "db:reset": "node scripts/resetDb.js",
    "admin:create": "node scripts/createAdmin.js",
    "admin:password": "node scripts/updateAdminPassword.js",
    "lint": "eslint ."
  },
  "author": "JERA Bevala Juliot",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-postgis": "^0.2.16",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000
  },
  "nodemonConfig": {
    "ignore": [
      ".donnees/*",
      "uploads/*",
      "tests/*"
    ]
  }
}
