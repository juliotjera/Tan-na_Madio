# ── Tanàna Madio — configuration de l'API ──────────────────────
# Copier ce fichier en « .env ». Sans base configurée, l'API utilise PGlite
# (PostgreSQL + PostGIS en WebAssembly, fichiers dans backend/.donnees) : rien à installer.

PORT=3000
NODE_ENV=development

# Base PostgreSQL + PostGIS (production) : l'une ou l'autre forme
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/tananamadio?sslmode=require
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tananamadio
# DB_USER=postgres
# DB_PASSWORD=

# Forcer un moteur : postgres | pglite | memoire (tests)
# DB_MODE=pglite

# Secrets JWT : OBLIGATOIRES en production, longs et aléatoires. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES=7d

# Photos des signalements
UPLOAD_MAX_MB=5
# UPLOAD_DIR=./uploads

# Origines autorisées (frontend), séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
